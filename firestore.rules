rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'phidephefem@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Children Collection
    match /children/{childId} {
      allow get: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(childId) && (request.resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(childId) && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(childId) && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(attendanceId) && (request.resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(attendanceId) && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(attendanceId) && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // Safety Tasks Collection
    match /safetyTasks/{taskId} {
      allow get: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(taskId) && (request.resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(taskId) && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(taskId) && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // Incidents Collection
    match /incidents/{incidentId} {
      allow get: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(incidentId) && (request.resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(incidentId) && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Daily Reports Collection
    match /dailyReports/{reportId} {
      allow get: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(reportId) && (request.resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(reportId) && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(reportId) && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
